{
    "nixEnvSelector.nixFile": "${workspaceFolder}/shell.nix",
    "hidefiles.configurationType": "global",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "__pycache__/": true,
        "debugging/__pycache__/": true,
        "layouts/__pycache__/": true,
        "sequence/__pycache__/": true
    }
}